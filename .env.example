# This is an example environment file for the verto application.

# PostgreSQL database configuration
POSTGRES_USER=verto
POSTGRES_PASSWORD=verto_dev
POSTGRES_DB=verto
POSTGRES_URL=postgresql://verto:verto_dev@localhost:5433/verto

# MongoDB database configuration
MONGO_URL=mongodb://localhost:27017

# Redis configuration
REDIS_URL=redis://localhost:6379

# Neo4j database configuration
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=verto_neo_password

# Qdrant configuration
QDRANT_URL=http://localhost:6333